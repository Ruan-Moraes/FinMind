generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings        UserSettings?
  accounts        Account[]
  creditCards     CreditCard[]
  categories      Category[]
  transactions    Transaction[]
  budgets         Budget[]
  portfolioGoals  PortfolioGoal[]
  recurrenceRules   RecurrenceRule[]
  installmentGroups InstallmentGroup[]
  aiReports         AiAnalysisReport[]
  importBatches     StatementImportBatch[]
  memoryRules       ReconciliationMemoryRule[]
  knowledgeChunks   FinancialKnowledgeChunk[]
  valueForecastItems  ValueForecastItem[]
  balanceTargetChecks BalanceTargetCheck[]
  aiChatSessions      AiChatSession[]
  holidays            Holiday[]
  agentAuditLogs      AgentActionAuditLog[]
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               String   @default("DARK")         // LIGHT | DARK | SYSTEM
  density             String   @default("COMFORTABLE")  // COMFORTABLE | COMPACT
  hideValuesByDefault Boolean  @default(false)
  fiscalMonthStartDay Int      @default(1)              // 1 a 31
  defaultAccountId    String?
  holidayState        String?  // UF do usuário para feriados estaduais (ex: MG, SP)
  holidayCity         String?  // Cidade do usuário para feriados municipais

  // Configurações de IA (Assinatura & Cota API) salvas no banco (RF-27)
  aiProvider          String   @default("OPENAI")       // OPENAI | GEMINI | CLAUDE
  aiConnectionMode    String   @default("SUBSCRIPTION") // SUBSCRIPTION | API_QUOTA
  openaiApiKey        String?
  geminiApiKey        String?
  claudeApiKey        String?
  openaiModel         String   @default("gpt-4o-mini")
  geminiModel         String   @default("gemini-2.0-flash")
  claudeModel         String   @default("claude-3-5-sonnet-latest")

  updatedAt           DateTime @updatedAt
}

model AiAnalysisReport {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   // OPENAI | GEMINI | CLAUDE
  connectionMode String   // SUBSCRIPTION | API_QUOTA | SMART_LOCAL
  healthScore    Int      @default(80) // 0 a 100
  summary        String
  strengthsJson  String   @default("[]")
  risksJson      String   @default("[]")
  actionPlanJson String   @default("[]")
  createdAt      DateTime @default(now())
}

model Account {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  type                  String   @default("CHECKING") // CHECKING | SAVINGS | CASH
  initialBalanceInCents Int      @default(0)
  color                 String   @default("#10b981")
  isArchived            Boolean  @default(false)
  createdAt             DateTime @default(now())

  sourceTransactions      Transaction[]    @relation("SourceAccount")
  destinationTransactions Transaction[]    @relation("DestinationAccount")
  recurrenceRules         RecurrenceRule[]
}

model CreditCard {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  brand        String   @default("Mastercard")
  limitInCents Int      @default(0)
  closingDay   Int      @default(25) // 1 a 31
  dueDay       Int      @default(5)  // 1 a 31
  color        String   @default("#6366f1")
  createdAt    DateTime @default(now())

  invoices        CreditCardInvoice[]
  transactions    Transaction[]
  recurrenceRules RecurrenceRule[]
}

model CreditCardInvoice {
  id                String      @id @default(cuid())
  creditCardId      String
  creditCard        CreditCard  @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  month             Int         // 1 a 12
  year              Int         // ex: 2026
  status            String      @default("OPEN") // OPEN | CLOSED | PAID
  paidAmountInCents Int         @default(0)
  paidAt            DateTime?
  createdAt         DateTime    @default(now())

  transactions Transaction[]

  @@unique([creditCardId, month, year])
}

model Category {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  type          String   @default("EXPENSE")  // INCOME | EXPENSE
  defaultNature String   @default("VARIABLE") // STATIC | VARIABLE
  color         String   @default("#6366f1")
  icon          String   @default("Tag")
  createdAt     DateTime @default(now())

  subcategories   Subcategory[]
  transactions    Transaction[]
  budgets         Budget[]
  recurrenceRules RecurrenceRule[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String

  transactions Transaction[]
}

model InstallmentGroup {
  id                 String   @id @default(cuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  description        String
  totalAmountInCents Int
  totalInstallments  Int
  createdAt          DateTime @default(now())

  transactions Transaction[]

  @@index([userId])
}

model RecurrenceRule {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  description   String
  type          String      @default("EXPENSE") // INCOME | EXPENSE
  nature        String      @default("STATIC")  // STATIC | VARIABLE
  amountInCents Int
  frequency       String      @default("MONTHLY")      // MONTHLY | WEEKLY | YEARLY
  dayOfMonth      Int         @default(5)
  dayType         String      @default("CALENDAR_DAY") // CALENDAR_DAY | BUSINESS_DAY
  includeSaturday Boolean     @default(false)          // Regra CLT (considera sábado útil)
  skippedMonths    String      @default("[]")           // JSON array de meses pulados ["2026-11"]
  monthlyOverrides String      @default("{}")           // JSON map {"2026-11": 52000} de valores ajustados no mês
  isActive         Boolean     @default(true)
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId     String?
  account       Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  creditCardId  String?
  creditCard    CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  transactions Transaction[]
}

model Transaction {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                 String             // INCOME | EXPENSE | TRANSFER
  nature               String             @default("VARIABLE") // STATIC | VARIABLE
  amountInCents        Int
  date                 DateTime
  description          String
  status               String             @default("COMPLETED") // COMPLETED | PENDING
  tags                 String             @default("")          // Comma-separated tags ex: "viagem,trabalho"
  sourceAccountId      String?
  sourceAccount        Account?           @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  destinationAccountId String?
  destinationAccount   Account?           @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: SetNull)
  creditCardId         String?
  creditCard           CreditCard?        @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  invoiceId            String?
  invoice              CreditCardInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  categoryId           String?
  category             Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryId        String?
  subcategory          Subcategory?       @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  installmentGroupId   String?
  installmentGroup     InstallmentGroup?  @relation(fields: [installmentGroupId], references: [id], onDelete: Cascade)
  recurrenceRuleId        String?
  recurrenceRule          RecurrenceRule?       @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  installmentNumber       Int?
  totalInstallments       Int?
  importBatchId           String?
  importBatch             StatementImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importFileId            String?
  importFile              StatementImportFile?  @relation(fields: [importFileId], references: [id], onDelete: SetNull)
  externalTransactionHash String?
  rawBankDescription      String?
  financialAction         String?
  counterparty            String?
  paymentMethod           String?
  purpose                 String?
  aiConfidenceScore       Int?
  aiConfidenceLevel       String?
  isAiClassified          Boolean               @default(false)
  isUserConfirmed         Boolean               @default(true)
  createdAt               DateTime              @default(now())

  attachments Attachment[]

  @@index([userId, date])
  @@index([userId, type, nature])
  @@index([invoiceId])
  @@index([userId, externalTransactionHash])
  @@index([importBatchId])
}

model StatementImportBatch {
  id                       String                @id @default(cuid())
  userId                   String
  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                   String                @default("COMMITTED") // COMMITTED | REVERTED
  fileCount                Int                   @default(1)
  totalMovements           Int                   @default(0)
  reconciledCount          Int                   @default(0)
  createdTransactionsCount Int                   @default(0)
  skippedDuplicatesCount   Int                   @default(0)
  aiProvider               String                @default("OPENAI")
  aiModelId                String                @default("gpt-4o-mini")
  summaryJson              String                @default("{}") // Snapshot de auditoria e rollback
  createdAt                DateTime              @default(now())
  revertedAt               DateTime?

  files        StatementImportFile[]
  transactions Transaction[]

  @@index([userId, createdAt])
}

model StatementImportFile {
  id          String               @id @default(cuid())
  batchId     String
  batch       StatementImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fileName    String
  fileFormat  String               @default("CSV") // CSV | OFX | XLSX | PDF | TXT
  bankName    String               @default("Instituição Financeira")
  periodStart DateTime?
  periodEnd   DateTime?
  fileHash    String               @default("")
  itemCount   Int                  @default(0)
  status      String               @default("PROCESSED") // PROCESSED | PARTIAL | ERROR
  createdAt   DateTime             @default(now())

  transactions Transaction[]
}

model ReconciliationMemoryRule {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  normalizedPattern String
  merchantKeyword   String   @default("")
  financialAction   String   @default("")
  purpose           String   @default("")
  targetType        String   @default("EXPENSE") // INCOME | EXPENSE | TRANSFER
  nature            String   @default("VARIABLE") // STATIC | VARIABLE
  categoryId        String?
  recurrenceRuleId  String?
  confirmCount      Int      @default(1)
  lastConfirmedAt   DateTime @default(now())
  createdAt         DateTime @default(now())

  @@unique([userId, normalizedPattern])
  @@index([userId, merchantKeyword])
}

model Budget {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month            Int
  year             Int
  maxAmountInCents Int
  createdAt        DateTime @default(now())

  @@unique([userId, categoryId, month, year])
}

model PortfolioGoal {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  targetAmountInCents Int      // ex: 700000 para R$ 7.000,00
  targetMonth         Int      // 1 a 12
  targetYear          Int      // ex: 2026
  status              String   @default("IN_PROGRESS") // IN_PROGRESS | ACHIEVED | CANCELLED
  notes               String?
  createdAt           DateTime @default(now())
}

model Attachment {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  sizeInBytes   Int
  fileDataUrl   String      // Base64 Data URL ou URL Cloudflare R2
  createdAt     DateTime    @default(now())
}

model FinancialKnowledgeChunk {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType     String    // TRANSACTION | RECURRENCE_RULE | PORTFOLIO_GOAL | BUDGET | MONTHLY_SUMMARY
  sourceId       String
  referenceDate  DateTime?
  month          Int?
  year           Int?
  categoryId     String?
  amountInCents  Int?
  title          String
  contentText    String
  metadataJson   String    @default("{}")
  contentHash    String
  embeddingJson  String    @default("[]")
  embeddingModel String    @default("none")
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@unique([userId, sourceType, sourceId])
  @@index([userId, sourceType])
  @@index([userId, year, month])
}

model ValueForecastItem {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  type          String   // INCOME | EXPENSE
  amountInCents Int
  expectedDate  DateTime
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, expectedDate])
}

model BalanceTargetCheck {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  plannedBalanceInCents Int
  targetDate            DateTime
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, targetDate])
}

model AiChatSession {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AiChatMessage[]

  @@index([userId, updatedAt])
}

model AiChatMessage {
  id           String        @id @default(cuid())
  sessionId    String
  session      AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String        // user | assistant
  content      String
  responseJson String?       // JSON serializado de AssistantStructuredResponse
  createdAt    DateTime      @default(now())

  @@index([sessionId, createdAt])
}

model Holiday {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD (timezone-safe)
  year      Int
  name      String
  scope     String   @default("NATIONAL")   // NATIONAL | STATE | MUNICIPAL
  stateCode String?
  cityName  String?
  source    String   @default("BRASIL_API") // BRASIL_API | STATE_CATALOG | AI | MANUAL
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, date, name])
  @@index([userId, year])
}

model SystemKnowledgeDocument {
  id          String                 @id @default(cuid())
  docId       String                 @unique
  filePath    String
  module      String
  version     String
  contentHash String
  chunkCount  Int                    @default(0)
  indexedAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  chunks      SystemKnowledgeChunk[]

  @@index([module])
}

model SystemKnowledgeChunk {
  id               String                  @id @default(cuid())
  documentId       String
  document         SystemKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  docId            String
  chunkIndex       Int
  module           String
  sectionPath      String
  screensJson      String                  @default("[]")
  relatedToolsJson String                  @default("[]")
  tagsJson         String                  @default("[]")
  contentText      String
  contentHash      String
  embeddingJson    String                  @default("[]")
  embeddingModel   String                  @default("none")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([docId, chunkIndex])
  @@index([module])
}

model AgentActionAuditLog {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId              String?
  runId                  String
  idempotencyKey         String   @unique
  modality               String   // ANALYTICAL | AUTONOMOUS | INTERACTIVE_GUIDE | ANNOTATED_SCREENSHOT | HYBRID
  toolName               String
  riskLevel              String   // L0 | L1 | L2 | L3 | BLOCKED
  status                 String   // PLANNED | AWAITING_CONFIRMATION | EXECUTING | SUCCEEDED | FAILED | CANCELLED | ROLLED_BACK
  paramsJson             String   @default("{}")
  beforeStateJson        String?
  afterStateJson         String?
  verificationResultJson String?
  errorMessage           String?
  durationMs             Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([runId])
}
