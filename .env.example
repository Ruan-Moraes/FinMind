# ==============================================================================
# FinMind — Variáveis de Ambiente (.env.example)
# ==============================================================================

# 1. Banco de Dados Local (SQLite) — usado em desenvolvimento e CI
DATABASE_URL="file:./dev.db"

# 2. Banco de Dados Remoto Gratuito — Turso (libSQL) para produção na Vercel
# Deixe vazio em desenvolvimento local para usar o SQLite local automaticamente.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# 3. Autenticação pública e criptografia AES-256-GCM das chaves de IA
# Gere em produção com: openssl rand -base64 32
AUTH_SECRET=""
# Convite de uso único para escolher o e-mail e a senha na tela de cadastro.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SETUP_TOKEN=""

# Na Vercel e na Netlify, o login é obrigatório mesmo se REQUIRE_AUTH estiver como false.
# Para testar login obrigatório localmente, defina REQUIRE_AUTH="true".
REQUIRE_AUTH="false"

# 4. Conta inicial local. Em produção, ADMIN_EMAIL pode identificar o titular legado na migração.
ADMIN_EMAIL="admin@finmind.app"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador FinMind"

# 5. Provedores de IA (Opcionais — também podem ser configurados pela interface e salvos criptografados)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
